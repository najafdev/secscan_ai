#!/bin/bash
# OpenOS ISO Build Configuration
# Wraps `lb config` with OpenOS defaults

set -e

lb config noauto \
    --architectures amd64 \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components username=openos hostname=openos" \
    --debian-installer none \
    --memtest none \
    --iso-application "OpenOS" \
    --iso-publisher "OpenOS Project" \
    --iso-volume "OpenOS Live" \
    --debootstrap-options "--include=apt-transport-https,ca-certificates" \
    "${@}"

echo "✅ OpenOS build configured."
